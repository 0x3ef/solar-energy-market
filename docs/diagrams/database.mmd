    USERS {
        uuid id PK
        string email UK
        string status
    }
    HOMES {
        uuid id PK
        uuid owner_id FK
        string name
    }
    DEVICES {
        uuid id PK
        uuid home_id FK
        string device_code UK
    }
    TELEMETRY_MESSAGES {
        uuid id PK
        uuid device_id FK
        bigint sequence_number
        jsonb payload
    }
    ENERGY_INTERVALS {
        uuid id PK
        uuid home_id FK
        bigint eligible_export_wh
    }
    ENERGY_CREDITS {
        uuid id PK
        uuid interval_id FK
        numeric token_amount
    }
    ORDERS {
        uuid id PK
        uuid seller_id FK
        numeric remaining_amount
    }
    TRADES {
        uuid id PK
        uuid order_id FK
        uuid buyer_id FK
    }
    WALLETS {
        uuid id PK
        uuid user_id FK
        string address UK
    }
    REDEMPTIONS {
        uuid id PK
        uuid wallet_id FK
        numeric token_amount
    }
    BLOCKCHAIN_TRANSACTIONS {
        uuid id PK
        string idempotency_key UK
        string transaction_hash UK
    }
    BLOCKCHAIN_EVENTS {
        uuid id PK
        uuid transaction_id FK
        bigint block_number
    }
