# =============================================================================
# Solar Energy Market — environment template
#
# Copy this file to `infrastructure/docker/.env` (the `setup.sh` script
# does it automatically) and adjust the values for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL / TimescaleDB
# -----------------------------------------------------------------------------
POSTGRES_USER=solar
POSTGRES_PASSWORD=solar
POSTGRES_DB=solar

# -----------------------------------------------------------------------------
# Simulator
# -----------------------------------------------------------------------------
INTERVAL_SECONDS=15
LOG_LEVEL=INFO

# Publisher mode for the gRPC gateway: console | mqtt
PUBLISHER=mqtt

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-in-production

# -----------------------------------------------------------------------------
# Blockchain
#
# The three contract addresses are injected by `scripts/setup.sh` after
# the first `forge script Deploy.s.sol` run. Do not edit them by hand
# unless you are deploying to a different network.
# -----------------------------------------------------------------------------
WEB3_PROVIDER_URL=http://anvil:8545
SUN_TOKEN_ADDRESS=
ENERGY_MARKET_ADDRESS=
REDEMPTION_MANAGER_ADDRESS=

# Default Anvil account #0 private key. Replace with a real key when
# deploying to a public network, and store it in a secret manager.
BACKEND_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Redemption rate: wei paid per whole SUN token (18 decimals).
# 1000000000000000 = 0.001 ETH per SUN.
WEI_PER_TOKEN=1000000000000000
