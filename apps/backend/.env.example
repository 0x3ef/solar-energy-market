# Database
DATABASE_URL=postgresql+asyncpg://solar:solar@timescaledb:5432/solar
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# MQTT ingest
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=solar/#
MQTT_QOS=1
MQTT_CLIENT_ID=solar-backend
QUEUE_MAXSIZE=10000
BATCH_SIZE=500
BATCH_FLUSH_SECONDS=1.0

# Blockchain
WEB3_PROVIDER_URL=http://localhost:8545
SUN_TOKEN_ADDRESS=
ENERGY_MARKET_ADDRESS=
REDEMPTION_MANAGER_ADDRESS=
BACKEND_PRIVATE_KEY=

# API
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

LOG_LEVEL=INFO