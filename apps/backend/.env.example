# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# PostgreSQL / TimescaleDB
DATABASE_URL=postgresql+asyncpg://solar:solar@timescaledb:5432/solar
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# JWT and sessions
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=15

# Durable workers and MQTT
REDIS_URL=redis://redis:6379/0
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=solar/#
MQTT_QOS=1
MQTT_CLIENT_ID=solar-backend
QUEUE_MAXSIZE=10000
BATCH_SIZE=500
BATCH_FLUSH_SECONDS=1.0

# EVM
WEB3_PROVIDER_URL=http://anvil:8545
CHAIN_ID=31337
SUN_TOKEN_ADDRESS=
ENERGY_MARKET_ADDRESS=
REDEMPTION_MANAGER_ADDRESS=
BACKEND_PRIVATE_KEY=
BLOCKCHAIN_CONFIRMATION_BLOCKS=1
BLOCKCHAIN_RECEIPT_TIMEOUT_SECONDS=120
