# syntax=docker/dockerfile:1.7
# ============================================================================
# Stage 1 — base runtime
# ============================================================================
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app

WORKDIR /app

COPY apps/backend/requirements.txt ./
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY apps/backend/ .

# Copy the Solidity ABIs (produced by `forge build` before docker build).
COPY contracts/out ./contracts/out

# ============================================================================
# Stage 2 — API (Chalice local)
# ============================================================================
FROM base AS api
EXPOSE 8000
CMD ["chalice", "local", "--host", "0.0.0.0", "--port", "8000"]

# ============================================================================
# Stage 3 — MQTT ingest worker
# ============================================================================
FROM base AS subscriber
CMD ["python", "-m", "solar_market.iot"]

# ============================================================================
# Stage 4 — tests
# ============================================================================
FROM base AS tests
RUN pip install pytest pytest-asyncio pytest-cov aiosqlite
CMD ["pytest"]